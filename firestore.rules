rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'preferredCrop',
          'defaultAlgorithm',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'preferredCrop',
          'defaultAlgorithm',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.preferredCrop is string
        && data.preferredCrop.size() >= 1
        && data.preferredCrop.size() <= 40
        && data.defaultAlgorithm is string
        && data.defaultAlgorithm.size() >= 1
        && data.defaultAlgorithm.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedFieldPin(data) {
      return data.keys().hasAll([
          'ownerId',
          'name',
          'country',
          'latitude',
          'longitude',
          'recommendedCrop',
          'predictedYield',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'name',
          'country',
          'latitude',
          'longitude',
          'recommendedCrop',
          'predictedYield',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.country is string
        && data.country.size() <= 80
        && data.latitude is number
        && data.latitude >= -90
        && data.latitude <= 90
        && data.longitude is number
        && data.longitude >= -180
        && data.longitude <= 180
        && data.recommendedCrop is string
        && data.recommendedCrop.size() >= 1
        && data.recommendedCrop.size() <= 40
        && data.predictedYield is number
        && data.predictedYield >= 0
        && data.predictedYield <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'preferredCrop',
          'defaultAlgorithm',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /savedFields/{fieldId} {
      allow get: if isSignedIn()
        && isValidId(fieldId)
        && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn()
        && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(fieldId)
        && isValidSavedFieldPin(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(fieldId)
        && isValidSavedFieldPin(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'recommendedCrop',
          'predictedYield',
          'updatedAt'
        ]);
      allow delete: if isVerifiedUser()
        && isValidId(fieldId)
        && existing().ownerId == request.auth.uid;
    }
  }
}
